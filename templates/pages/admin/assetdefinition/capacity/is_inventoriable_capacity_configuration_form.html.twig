{% import 'components/form/fields_macros.html.twig' as fields %}

<twig:Alert:Info
    important
    class="d-flex align-items-center"
    role="alert"
    :heading="__('Please select the type that represents the best the asset.')"
    :content="__('We need this information to send the inventory file in the correct inventory engine of the GLPI framework.')"
/>

{{ fields.dropdownArrayField(
    fieldname_prefix ~ '[inventory_mainasset]',
    current_config.getValue('inventory_mainasset'),
    itemtype_choices,
    '',
    {
        'no_label': true,
    }
) }}
